<Window x:Class="SC2Uncensor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC2 Uncensor"
        Height="520" Width="720"
        MinHeight="420" MinWidth="560"
        Background="#1B1E24"
        Foreground="#E8ECF1"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"
               Text="SC2 Uncensor"/>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="0,0,0,12" Foreground="#9AA4B2"
               Text="starting..."/>
    <UniformGrid DockPanel.Dock="Top" Columns="2" Rows="3" Margin="0,0,0,12">
      <Button Margin="0,0,8,8" Height="36" Click="OnUncensorAuto" Content="F9  auto"/>
      <Button Margin="0,0,0,8" Height="36" Click="OnUncensor" Content="F8  memory only"/>
      <Button Margin="0,0,8,8" Height="36" Click="OnToggle" Content="F11 toggle"/>
      <Button Margin="0,0,0,8" Height="36" Click="OnStatus" Content="status"/>
      <Button Margin="0,0,8,8" Height="36" Click="OnRestoreAuto" Content="restore auto"/>
      <Button Margin="0,0,0,8" Height="36" Click="OnRestore" Content="restore memory"/>
    </UniformGrid>
    <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="12"
             Background="#12151A" Foreground="#D7DEE8" BorderBrush="#2A303A"
             TextWrapping="Wrap" AcceptsReturn="True"/>
  </DockPanel>
</Window>
